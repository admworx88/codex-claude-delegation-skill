{
  "id": "task-001",
  "goal": "Implement the password-reset API endpoint.",
  "mode": "direct",
  "baseBranch": "main",
  "featureBranch": "feature/password-reset",
  "allowedPaths": ["src/auth/**", "tests/auth/**"],
  "forbiddenPaths": [".git/**", ".github/**", ".env*", "secrets/**", "credentials/**"],
  "forbiddenActions": [
    "git commit",
    "git push",
    "git pull",
    "git fetch",
    "git merge",
    "git rebase",
    "git reset",
    "git checkout",
    "git switch",
    "git stash",
    "git tag",
    "git remote",
    "git worktree",
    "read or expose secrets",
    "read or expose credentials"
  ],
  "context": ["Codex owns acceptance and repository history."],
  "acceptanceCriteria": ["Unknown emails receive a generic response.", "Tokens expire after 30 minutes."],
  "requiredVerification": ["Run the focused authentication test suite."],
  "limits": {
    "maxTurns": 30,
    "timeoutSeconds": 1800,
    "maxBudgetUsd": 5.0
  }
}
